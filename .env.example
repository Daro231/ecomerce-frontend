# ==============================================================================
# Next.js Frontend Environment Variables (.env.example)
# In Next.js, NEXT_PUBLIC_* variables are inlined into client JavaScript at BUILD TIME.
# These variables MUST be defined in Railway BEFORE triggering a build/deployment.
# If you change any NEXT_PUBLIC_* variable later, you MUST redeploy the service.
# ==============================================================================

# Backend API Base URL (including /api/v1)
# Point to your backend's public Railway domain with https://
# Example: https://ecom-backend-production.up.railway.app/api/v1
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api/v1

# Backend static/uploaded files URL (no trailing slash)
# Used to display uploaded product and brand images
# Example: https://ecom-backend-production.up.railway.app
NEXT_PUBLIC_FILE_URL=https://your-backend.up.railway.app

# Default promo coupon shown on checkout page (e.g. WELCOME10)
NEXT_PUBLIC_PROMO_COUPON=WELCOME10

# Optional contact string (email/website) sent to OpenStreetMap Nominatim for geocoding
NEXT_PUBLIC_NOMINATIM_CONTACT=

# Optional server-side proxy URL (only used if proxying requests through Next.js rewrites)
# Private Railway networking can be used here: http://backend.railway.internal:8080
BACKEND_URL=
