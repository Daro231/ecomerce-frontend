# ==============================================================================
# Next.js Frontend Environment Variables (.env.example)
# NEXT_PUBLIC_* variables are inlined into client JS at BUILD TIME.
# Set them in Railway BEFORE building or redeploy if modified.
# ==============================================================================

# App
# required (build-time inlined; full public URL of backend with /api/v1)
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app/api/v1
# required (build-time inlined; public URL of backend for uploaded static files)
NEXT_PUBLIC_FILE_URL=https://your-backend.up.railway.app
# optional (default: empty; promo coupon auto-applied on checkout)
NEXT_PUBLIC_PROMO_COUPON=WELCOME10
# optional (default: empty; contact email sent to Nominatim for map geocoding)
NEXT_PUBLIC_NOMINATIM_CONTACT=contact@example.com
# optional (default: 3000; port Next.js server listens on)
PORT=3000
# optional (default: 0.0.0.0; host binding)
HOSTNAME=0.0.0.0
# optional (default: production)
NODE_ENV=production

# Server-side Proxy (optional)
# optional (only used if proxying requests through Next.js rewrites; private Railway networking URL)
BACKEND_URL=http://backend.railway.internal:8080
